<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>uk.me.mantas</groupId>
	<artifactId>eternity</artifactId>
	<version>1.1.1-beta</version>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
	</properties>

	<!-- Maven 'hack' to include our bundled dependencies as normal maven
	dependencies so we don't have to mess around with the classpath at all -->

	<repositories>
		<repository>
			<id>lib</id>
			<releases>
				<enabled>true</enabled>
				<checksumPolicy>ignore</checksumPolicy>
			</releases>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
			<url>file://${project.basedir}/lib</url>
		</repository>
	</repositories>

	<dependencies>

		<!-- Local Dependencies -->
		<dependency>
			<groupId>dependencies</groupId>
			<artifactId>gluegen-rt</artifactId>
			<version>1.0</version>
		</dependency>
		<dependency>
			<groupId>dependencies</groupId>
			<artifactId>jcef</artifactId>
			<version>1.0</version>
		</dependency>
		<dependency>
			<groupId>dependencies</groupId>
			<artifactId>jogl-all</artifactId>
			<version>1.0</version>
		</dependency>

		<!-- External Dependencies -->
		<dependency>
			<groupId>org.json</groupId>
			<artifactId>json</artifactId>
			<version>20250517</version>
		</dependency>
		<dependency>
			<groupId>commons-io</groupId>
			<artifactId>commons-io</artifactId>
			<version>2.22.0</version>
		</dependency>
		<dependency>
			<groupId>net.lingala.zip4j</groupId>
			<artifactId>zip4j</artifactId>
			<version>2.11.6</version>
		</dependency>
		<dependency>
			<groupId>org.jooq</groupId>
			<artifactId>joox</artifactId>
			<version>1.3.0</version>
		</dependency>
		<dependency>
			<groupId>org.jooq</groupId>
			<artifactId>jool</artifactId>
			<version>0.9.6</version>
		</dependency>
		<dependency>
			<groupId>joda-time</groupId>
			<artifactId>joda-time</artifactId>
			<version>2.7</version>
		</dependency>
		<dependency>
			<groupId>com.google.guava</groupId>
			<artifactId>guava</artifactId>
			<version>33.7.2-jre</version>
		</dependency>
		<dependency>
			<groupId>ch.qos.logback</groupId>
			<artifactId>logback-classic</artifactId>
			<version>1.3.16</version>
		</dependency>
		<dependency>
			<groupId>se.softhouse</groupId>
			<artifactId>jargo</artifactId>
			<version>0.1.1</version>
		</dependency>

		<!-- Test Dependencies -->
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>4.13.2</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-core</artifactId>
			<version>2.2.7</version>
			<scope>test</scope>
		</dependency>

	</dependencies>

	<profiles>
		<profile>
			<id>linux64</id>
			<dependencies>
				<dependency>
					<groupId>dependencies</groupId>
					<artifactId>gluegen-rt-natives-linux-amd64</artifactId>
					<version>1.0</version>
				</dependency>
				<dependency>
					<groupId>dependencies</groupId>
					<artifactId>jogl-all-natives-linux-amd64</artifactId>
					<version>1.0</version>
				</dependency>
			</dependencies>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-shade-plugin</artifactId>
						<version>2.3</version>
						<configuration>
							<transformers>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>uk.me.mantas.eternity.Launcher</mainClass>
								</transformer>
							</transformers>
							<!-- The jar runs on Java 8, from the class path: the module
							     descriptors and Java 9+ variants its libraries carry are
							     never read, and one library's descriptor at the root of a
							     jar holding all of them would describe the wrong thing. -->
							<filters>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>module-info.class</exclude>
										<exclude>META-INF/versions/**</exclude>
									</excludes>
								</filter>
							</filters>
							<artifactSet>
								<excludes>
									<!--
									 | We exclude the native dependencies from the UberJAR on linux because this
									 | causes weird crashes for some reason. These need to be packaged separately
									 | and specified on the java classpath when the linux version is run.
									 -->
									<exclude>dependencies:*</exclude>
								</excludes>
							</artifactSet>
						</configuration>
						<executions>
							<execution>
								<phase>package</phase>
								<goals>
									<goal>shade</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>win64</id>
			<dependencies>
				<dependency>
					<groupId>dependencies</groupId>
					<artifactId>gluegen-rt-natives-windows-amd64</artifactId>
					<version>1.0</version>
				</dependency>
				<dependency>
					<groupId>dependencies</groupId>
					<artifactId>jogl-all-natives-windows-amd64</artifactId>
					<version>1.0</version>
				</dependency>
			</dependencies>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-shade-plugin</artifactId>
						<version>2.3</version>
						<configuration>
							<transformers>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>uk.me.mantas.eternity.Launcher</mainClass>
								</transformer>
							</transformers>
							<!-- The jar runs on Java 8, from the class path: the module
							     descriptors and Java 9+ variants its libraries carry are
							     never read, and one library's descriptor at the root of a
							     jar holding all of them would describe the wrong thing. -->
							<filters>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>module-info.class</exclude>
										<exclude>META-INF/versions/**</exclude>
									</excludes>
								</filter>
							</filters>
						</configuration>
						<executions>
							<execution>
								<phase>package</phase>
								<goals>
									<goal>shade</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<!-- "Eternity Keeper.exe": starts the jar beside it with the Java 8
					     runtime a release carries in its own jre folder, never whatever
					     java the machine has (the embedded browser's natives are Java 8
					     era). tools/release/build-release.ps1 puts the pieces together. -->
					<plugin>
						<groupId>com.akathist.maven.plugins.launch4j</groupId>
						<artifactId>launch4j-maven-plugin</artifactId>
						<version>1.7.25</version>
						<executions>
							<execution>
								<id>launcher</id>
								<phase>package</phase>
								<goals>
									<goal>launch4j</goal>
								</goals>
								<configuration>
									<headerType>gui</headerType>
									<outfile>${project.build.directory}/Eternity Keeper.exe</outfile>
									<jar>eternity-keeper.jar</jar>
									<dontWrapJar>true</dontWrapJar>
									<chdir>.</chdir>
									<errTitle>Eternity Keeper</errTitle>
									<icon>${project.basedir}/src/main/launcher/eternity-keeper.ico</icon>
									<singleInstance>
										<mutexName>EternityKeeper</mutexName>
										<windowTitle>Eternity Keeper</windowTitle>
									</singleInstance>
									<jre>
										<path>jre</path>
										<bundledJre64Bit>true</bundledJre64Bit>
										<runtimeBits>64</runtimeBits>
										<opts>
											<!-- Quoted: the install folder itself is "Eternity Keeper",
											     and Launch4j passes an option through exactly as written.
											     Unquoted, java took the path up to the first space and the
											     rest as the class to run, and the editor never started. -->
											<opt>"-Djava.library.path=%EXEDIR%\lib\native\win64"</opt>
										</opts>
									</jre>
									<messages>
										<startupErr>Eternity Keeper could not start.</startupErr>
										<!-- Two causes, and the second looks nothing like the first: the
										     launcher and Java 8 read their own paths in the computer's code
										     page, so from a folder named in another script (measured: Cyrillic
										     and Japanese on a Central European Windows) the jre is "not there". -->
										<bundledJreErr>Eternity Keeper could not find the Java runtime it ships with (the "jre" folder beside it). If the download was extracted whole, with every folder in it, the cause is where it was put: this folder's path has letters that Windows cannot pass on to the runtime. Move the Eternity Keeper folder to a path with plain letters, for example C:\Games, and start it again.</bundledJreErr>
										<jreVersionErr>The "jre" folder beside Eternity Keeper is not the Java 8 runtime it ships with. Re-extract the download.</jreVersionErr>
										<launcherErr>Eternity Keeper's launcher failed.</launcherErr>
									</messages>
									<versionInfo>
										<fileVersion>1.0.0.0</fileVersion>
										<txtFileVersion>${project.version}</txtFileVersion>
										<fileDescription>Eternity Keeper, a Pillars of Eternity save editor</fileDescription>
										<copyright>GNU General Public License v3 or later</copyright>
										<productVersion>1.0.0.0</productVersion>
										<txtProductVersion>${project.version}</txtProductVersion>
										<productName>Eternity Keeper</productName>
										<companyName>Eternity Keeper contributors</companyName>
										<internalName>eternity-keeper</internalName>
										<originalFilename>Eternity Keeper.exe</originalFilename>
									</versionInfo>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

	<build>
		<!-- A stable name, so launchers and scripts don't change with the version. -->
		<finalName>eternity-keeper</finalName>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.3</version>
				<configuration>
					<source>1.8</source>
					<target>1.8</target>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>2.18.1</version>
				<configuration>
					<forkCount>0</forkCount>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<version>2.7</version>
				<configuration>
					<nonFilteredFileExtensions>
						<nonFilteredFileExtension>xml</nonFilteredFileExtension>
					</nonFilteredFileExtensions>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
